{
  "name": "system-map",
  "displayName": "System Map",
  "description": "コードベースをアイソメ3D都市として横に並べて見る",
  "version": "0.1.0",
  "publisher": "shint-mcguff",
  "license": "ISC",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "systemMap.open",
        "title": "System Map: 街を開く",
        "category": "System Map"
      },
      {
        "command": "systemMap.reveal",
        "title": "System Map: このファイルのビルへ",
        "category": "System Map"
      }
    ],
    "configuration": {
      "title": "System Map",
      "properties": {
        "systemMap.updateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存したファイルだけを再解析して街を更新する"
        },
        "systemMap.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "アクティブなエディタに対応するビルを自動で選択する"
        },
        "systemMap.openFileOnClick": {
          "type": "boolean",
          "default": true,
          "description": "ビルをクリックしたら対応するファイルをエディタで開く"
        }
      }
    }
  }
}
